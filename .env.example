APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Comma-separated origins allowed to call this API from browsers (Nuxt admin on another host).
# No wildcard; use explicit HTTPS/HTTP URLs. Firebase uses Bearer tokens (supports_credentials stays false in config).
# Example: CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000
CORS_ALLOWED_ORIGINS=

# Optional cache for preflight responses (seconds).
# CORS_MAX_AGE=0

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# Local default: single file. Staging: stderr,otel (see OTEL_LOGS_EXPORTER above).
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Database queue: required for queued mail (e.g. AdminAccessRequestedMail). Run a worker in dev/prod:
#   php artisan queue:work --tries=3
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# DigitalOcean Spaces (S3-compatible). Laravel is the only writer; never commit secrets.
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_BUCKET=ixora-buckets
DO_SPACES_REGION=tor1
DO_SPACES_ENDPOINT=https://tor1.digitaloceanspaces.com
DO_SPACES_CDN_URL=https://ixora-buckets.tor1.cdn.digitaloceanspaces.com

VITE_APP_NAME="${APP_NAME}"

# Admin access approval (reviewer inbox for signed approve/reject links)
ADMIN_ACCESS_REVIEW_EMAIL=lucas_brito@outlook.com
# ADMIN_ACCESS_SIGNED_URL_TTL_DAYS=7

# Firebase Admin (Kreait): use ONE of these credential modes.
#
# Preferred on App Platform / CI — discrete env vars (no inline JSON blobs):
# FIREBASE_TYPE=service_account
# FIREBASE_PROJECT_ID=your-gcp-project
# FIREBASE_PRIVATE_KEY_ID=...
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n....\n-----END PRIVATE KEY-----\n"
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk@....iam.gserviceaccount.com
# FIREBASE_CLIENT_ID=...
# FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
# FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token
# FIREBASE_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
# FIREBASE_CLIENT_X509_CERT_URL=https://www.googleapis.com/robot/v1/metadata/x509/...
#
# PEM in .env uses real newlines inside quotes OR literal \n escapes (handled at runtime).
#
# Deprecated — single-line JSON blob (escaped quotes are brittle in some hosts):
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
#
# Local development — path to downloaded key JSON file (relative paths use Laravel base_path):
FIREBASE_CREDENTIALS=

#
# Native Android offline QA fixtures (front_vibes WDIO)
# ------------------------------------------------------------------
# After the user exists in `users` (mobile sign-in → /api/auth/sync), run once per environment:
#   php artisan ixora:seed-native-offline-qa --email=you@example.com
# Or set the email here and omit --email:
# NATIVE_QA_FIXTURE_USER_EMAIL=
#
# Optional HTTPS MP3 URLs for the two fixture layers (defaults: SoundHelix public samples):
# NATIVE_QA_FIXTURE_SOUND_URL_A=
# NATIVE_QA_FIXTURE_SOUND_URL_B=
#
# Debug (non-production only): authenticated GET /api/debug/me → id, email, firebase_uid, vibes_count.
# The route is not registered when APP_ENV=production — no separate env toggle.

#
# Observability — OpenTelemetry (Phase 7A: SDK foundation only — see
# docs/specs/observability-foundation/mvp/backend-sdk-foundation.md)
# ------------------------------------------------------------------
# APP_VERSION feeds service.version (telemetry-naming-convention.md §3). Set
# it at deploy time from the release tag; falls back to "unknown" locally.
APP_VERSION=

# Master kill switch read by config/telemetry.php. true disables the
# Telemetry Abstraction Layer entirely (NoopTelemetryManager is bound) —
# independent of OTEL_PHP_AUTOLOAD_ENABLED below.
OTEL_SDK_DISABLED=false

# service.name MUST be one of the official Ixora service names
# (telemetry-naming-convention.md §3): back_vibes-api (HTTP/PHP-FPM) or
# back_vibes-worker (queue workers / scheduled commands).
OTEL_SERVICE_NAME=back_vibes-api
OTEL_SERVICE_VERSION="${APP_VERSION}"
OTEL_SERVICE_NAMESPACE=ixora

# Points at the OpenTelemetry Collector ONLY (ADR-028) — OTLP/HTTP protobuf
# on port 4318, never Prometheus/Loki/Tempo directly. Example:
#   OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# "Authorization=Bearer <OTEL_INGEST_API_KEY_BACKEND>" — matches the
# Collector's bearertokenauth/backend extension (ixora-infra/collector/config.yaml).
OTEL_EXPORTER_OTLP_HEADERS=

# Additional raw resource attributes, "key1=value1,key2=value2" format.
#
# IMPORTANT (Phase 8.8.8 — resource identity finding):
# OTEL_SERVICE_NAMESPACE and OTEL_SERVICE_VERSION are NOT standard OpenTelemetry
# SDK environment variables and are NOT read by SdkAutoloader's Resource detectors.
# Only OTEL_SERVICE_NAME (→ service.name) is a recognised SDK variable.
# For service.namespace, service.version, and deployment.environment to appear
# in SDK-built resources (LogRecords, Spans, Metrics), set them here:
#
# Staging example:
# OTEL_RESOURCE_ATTRIBUTES=service.namespace=ixora,service.version=<release-tag>,deployment.environment=staging
#
# config/telemetry.php reads OTEL_SERVICE_NAMESPACE / OTEL_SERVICE_VERSION for
# Laravel-layer config only (metric labels, TelemetryConfig) — that path is
# correct and unchanged. It is the SDK's own resource that needs the above.
OTEL_RESOURCE_ATTRIBUTES=

# Head sampling — mirrors the Collector's probabilistic_sampler (ADR-031).
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.10

# --- Zero-code SDK bootstrap + auto-instrumentation -----------------------
# OTEL_PHP_AUTOLOAD_ENABLED=true triggers the OpenTelemetry PHP SDK's own
# SdkAutoloader at Composer class-autoload time — the officially documented,
# race-free way to build the TracerProvider/MeterProvider/Resource/Sampler
# from the OTEL_* variables above and register them as SDK globals before
# any auto-instrumentation hook can fire.
#
# CAVEAT (upstream OpenTelemetry PHP limitation, not an Ixora-specific
# issue): this autoloader runs BEFORE Laravel loads this .env file, so these
# OTEL_* variables must be real process/OS environment variables to take
# effect for auto-instrumentation and SDK export — not merely lines in a
# .env file read later by Laravel's own config() helper. In Docker/App
# Platform, set them in the container "environment:" section; for a local
# shell, `export` them (or use `export $(grep -v '^#' .env | xargs)`) before
# starting php-fpm/artisan serve/queue:work. config('telemetry.*') still
# reads .env normally and is used for the app's own kill switch, tests, and
# documentation — it does not by itself start the SDK.
OTEL_PHP_AUTOLOAD_ENABLED=false

# Selects which exporter backs traces/metrics/logs when the autoloader above
# runs. "otlp" requires OTEL_EXPORTER_OTLP_ENDPOINT to be set; "none"
# disables export while still allowing signals to be created (useful for
# local dev without a Collector). Default for logs is "none" — set to "otlp"
# in staging/production alongside LOG_STACK=stderr,otel.
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=none

# Minimum log level forwarded to the OTLP "otel" Monolog channel.
# Defaults to LOG_LEVEL when not set. "info" is the staging default.
OTEL_LOG_LEVEL=info

# Set to "all" wherever the `opentelemetry` PECL extension is NOT installed
# (e.g. a bare `composer install` on a machine without the extension) to
# silence the auto-instrumentation packages' startup warning and skip
# registering their hooks. Leave empty/unset in the production image, which
# bundles the extension (see backend-sdk-foundation.md §"Auto instrumentation").
OTEL_PHP_DISABLED_INSTRUMENTATIONS=all

# Context propagation format on outgoing/incoming HTTP — matches the
# Collector and every other Ixora service.
OTEL_PROPAGATORS=tracecontext,baggage
